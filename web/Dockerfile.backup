# The nightly backup job (deploy/web-compose.yml, service backup): Node 22 for scripts/backup-cron.ts, backup.ts and
# restore.ts, and the Postgres 17 client tools (pg_dump, psql, pg_restore) to match the database (supabase/postgres 17).
# The build context is web/. The scripts use only Node's own modules, so the image has no node_modules and no app code.
# tests/deploy.test.ts checks that every file the scripts import is copied below.
FROM node:22-bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && install -d /usr/share/postgresql-common/pgdg \
 && curl -fsSL -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc https://www.postgresql.org/media/keys/ACCC4CF8.asc \
 && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends postgresql-client-17 \
 && apt-get purge -y curl && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*
# The version's own folder first, so pg_dump is always 17 and never picked by Debian's wrapper.
ENV PATH=/usr/lib/postgresql/17/bin:$PATH NODE_ENV=production
RUN pg_dump --version | grep -q "(PostgreSQL) 17\." && node -e "process.exit(+process.versions.node.split('.')[0] >= 22 ? 0 : 1)"
WORKDIR /app
COPY package.json ./
COPY scripts/backup-cron.ts scripts/backup.ts scripts/restore.ts scripts/shell.ts ./scripts/
COPY src/lib/backup.ts ./src/lib/
USER node
CMD ["node", "--disable-warning=MODULE_TYPELESS_PACKAGE_JSON", "scripts/backup-cron.ts"]
