# Morning Telos web app settings. Real values live only in the server's environment, never in git.
# Each key comes from its own console. See "Keys and security" in the Morning Telos SaaS Plan.

# Supabase project sb-morningtelos (db.morningtelos.com): Project Settings, API Keys.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Claude API key named "Morning Telos" in console.anthropic.com. Pays for every workspace's AI.
ANTHROPIC_API_KEY=

# The partner API in each product (plan phase 2). The provision job makes each new workspace's brand there.
# The URL is the product's app address, like https://app.arrowsterr.com (no /api at the end).
# The key is a partner key (aw_partner_... or cb_partner_...) made in the Morning Telos workspace in that product.
# Empty means new workspaces wait with a setup problem until it is set.
ARROWSTERR_PARTNER_URL=
ARROWSTERR_PARTNER_KEY=
CAPYBAROAR_PARTNER_URL=
CAPYBAROAR_PARTNER_KEY=
# Checks that channel.connected and channel.lost really come from Capybaroar (POST /api/partner/capybaroar/webhook).
# Set the webhook once with the partner key: PUT <CAPYBAROAR_PARTNER_URL>/api/partner/webhook with
# {"url":"https://<this app>/api/partner/capybaroar/webhook"}. The answer shows the secret once, like whsec_...
# Empty means channel updates are turned away until it is set.
CAPYBAROAR_WEBHOOK_SECRET=

# The products' MCP servers, where the AI team's tools run with each workspace's own brand key (aw_brand_... or
# cbr_brand_..., made by the provision job and sealed in the database). Not secrets. Empty means the live servers:
# https://app.arrowsterr.com/api/mcp and https://app.capybaroar.com/api/mcp. Set them only to point at a test server.
ARROWSTERR_MCP_URL=
CAPYBAROAR_MCP_URL=

# Lets the server's every-minute call run background jobs (POST /api/worker, see its route.ts for the cron line).
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))". Empty means no jobs run.
CRON_SECRET=

# The Morning Telos Stripe account: Developers, API keys and Webhooks.
# The webhook is https://chat.morningtelos.com/api/billing/webhook. Prices come from npm run stripe:setup.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The app's public address, for links back from Stripe and in emails. Not a secret. Empty means https://chat.morningtelos.com.
APP_URL=

# Who can open the staff console (/staff): Morning Telos team emails, comma separated, like a@morningtelos.com,b@morningtelos.com.
# Not a secret; we pick it. A person must sign in with that email and have it confirmed. Empty means nobody.
STAFF_EMAILS=

# Resend API key. Empty means no emails: invite links are shown to copy instead. A send-only key is enough until the
# email door (TEAM_EMAIL_DOMAIN) is on; then it must be a full access key, to read received emails.
RESEND_API_KEY=
# Who emails come from. Empty means "Morning Telos <meet@morningtelos.com>". The domain must be verified in Resend.
EMAIL_FROM=
# Supabase, Authentication, Auth Hooks, Send Email (HTTPS): the secret it generates, like v1,whsec_...
SEND_EMAIL_HOOK_SECRET=

# The email door: each workspace's address is <slug>@TEAM_EMAIL_DOMAIN, like acme@team.morningtelos.com. Not a secret.
# Empty (the default) turns it off: the Settings section is hidden and /api/email/inbound answers 404. Set it once the
# MX record is verified in Resend (Domains, team.morningtelos.com, Enable Receiving) and the domain can send too.
TEAM_EMAIL_DOMAIN=
# Resend, Webhooks, the email.received webhook for https://chat.morningtelos.com/api/email/inbound: its signing secret,
# like whsec_... RESEND_API_KEY must be a full access key so it can read received emails (send-only keys can't).
RESEND_INBOUND_SECRET=

# Cloudflare Turnstile for the sign-up bot check.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# R2 token scoped to the morningtelos-backups bucket (Cloudflare, R2, Manage API tokens, Object Read and Write).
# R2_ENDPOINT is https://<account id>.r2.cloudflarestorage.com. R2_BUCKET defaults to morningtelos-backups.
# A shared bucket works too: set BACKUP_PREFIX below to keep our backups in their own folder.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Nightly backup (scripts/backup.ts). The database URL is the Supabase Postgres as the postgres user
# (Supabase, Project Settings, Database, or the self-hosted .env). The public key comes from
# "npm run restore -- keygen"; its private key stays in the password manager, never on the server.
# The ping URL is an optional heartbeat check (Healthchecks.io or Better Stack) that alerts on a missed night.
# BACKUP_PREFIX is the bucket folder for backups (default db/daily/). Set it when the bucket is shared with another
# product, like morningtelos/db/daily/. Only our own backup files in that folder are ever listed or deleted.
# These go only to the backup service in deploy/web-compose.yml, never to the web app.
BACKUP_DATABASE_URL=
BACKUP_PUBLIC_KEY=
BACKUP_PING_URL=
BACKUP_PREFIX=

# Sentry project morningtelos-web (sentry.io, Project Settings, Client Keys). Empty means off.
# NEXT_PUBLIC_SENTRY_DSN is for the browser and is read at build time. SENTRY_DSN is for the server, read at start.
# Both can be the same DSN. SENTRY_ENVIRONMENT is optional (defaults to NODE_ENV).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# PostHog project for Morning Telos (us.posthog.com, Project settings, Project API key, like phc_...). Not a secret.
# Read at build time, so it is the repo variable NEXT_PUBLIC_POSTHOG_KEY (Settings, Secrets and variables, Actions).
# Events go through /ingest on this app (next.config.ts). Empty means off: posthog-js is never loaded.
NEXT_PUBLIC_POSTHOG_KEY=

# Seals brand keys from Arrowsterr and Capybaroar before they are stored (web/src/lib/sealing.ts).
# kid:base64 pairs of 32-byte keys. Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SEALING_KEYS=
# The kid new values are sealed with. Empty means the first one in SEALING_KEYS.
SEALING_KEY_CURRENT=

# Composio: the customer's own apps (Settings, Apps; web/src/lib/composio). platform.composio.dev, the Morning Telos
# project, Settings, API keys. Empty means apps are off: Settings says so and the AI team gets no app tools.
COMPOSIO_API_KEY=
# Optional. Another Composio address. Empty means https://backend.composio.dev.
COMPOSIO_BASE_URL=
# Optional, one per app: our own app's auth config id (Composio, Auth configs, ac_...). Pipedrive and Help Scout need
# one before they connect (Composio has no app of its own for them). For the rest it puts our name on the sign-in
# screen. Empty means Composio's own app.
COMPOSIO_AUTH_CONFIG_GMAIL=
COMPOSIO_AUTH_CONFIG_OUTLOOK=
COMPOSIO_AUTH_CONFIG_GOOGLECALENDAR=
COMPOSIO_AUTH_CONFIG_CALENDLY=
COMPOSIO_AUTH_CONFIG_HUBSPOT=
COMPOSIO_AUTH_CONFIG_PIPEDRIVE=
COMPOSIO_AUTH_CONFIG_SALESFORCE=
COMPOSIO_AUTH_CONFIG_SLACK=
COMPOSIO_AUTH_CONFIG_ZENDESK=
COMPOSIO_AUTH_CONFIG_HELP_SCOUT=
# The website builders Hephaestus uses. Composio has no app of its own for any of them, so each needs one before it
# connects. Framer takes only an API key: make an API key auth config for Framer in Composio (Auth configs) and put
# its id here; the owner then gives their Framer project's address and API key on Composio's connect page.
COMPOSIO_AUTH_CONFIG_FRAMER=
# Webflow: our own Webflow app (Webflow, Workspace settings, Apps and integrations, Develop) with its client id and
# secret in a Composio OAuth auth config for Webflow. Scopes: sites:read, sites:write, pages:read, pages:write, cms:read,
# cms:write.
COMPOSIO_AUTH_CONFIG_WEBFLOW=
# WordPress.com: our own app (developer.wordpress.com/apps) with its client id and secret in a Composio OAuth auth
# config for WordPress.com.
COMPOSIO_AUTH_CONFIG_WORDPRESS_COM=
# Shopify: our own Shopify app (Shopify Dev Dashboard or Partners, a public app) with its client id and secret in a
# Composio OAuth auth config for Shopify. Scopes: read_content, write_content. Composio's connect page asks the owner
# for their store's myshopify.com name. Self-hosted WordPress needs nothing here: it connects without Composio.
COMPOSIO_AUTH_CONFIG_SHOPIFY=

# The Morning Telos Chrome extension's ids (extension/), comma separated: the Chrome Web Store id once it is listed
# (Developer Dashboard, the item's page) and any unpacked copy you test with (chrome://extensions, Developer mode).
# Not a secret. Only these get CORS on the routes the extension calls (src/lib/cors.ts). Empty means none.
EXTENSION_IDS=

# The database address the deploy uses to add new tables (scripts/migrate.mjs, run by deploy/deploy-web.sh).
# Only the server's .env needs it, never the app. From the Supabase stack on the server: the postgres user's
# connection string to its database container, e.g. postgres://postgres:<password>@<db container>:5432/postgres
MIGRATE_DATABASE_URL=
